# Pin LF for files this repo's tooling reads — git on Windows with the default
# core.autocrlf=true would otherwise check files out as CRLF, which breaks
# every shell hook (bash chokes on `\r`) and JSON manifest reads (jq passes the
# CR through, corrupting downstream string handling).
*.sh    text eol=lf
*.bash  text eol=lf
.husky/* text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.conf  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
