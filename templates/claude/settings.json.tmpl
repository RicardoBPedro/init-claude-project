{
  "_comment": "Generated by init-claude-project. __PROJECT_ROOT__ is substituted at install time with the absolute path of this project. Re-run the installer if the project is moved.",
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "out=$(bash __PROJECT_ROOT__/scripts/branch-hygiene.sh 2>&1); code=$?; if python3 --version >/dev/null 2>&1; then PY=python3; else PY=python; fi; if [ $code -ne 0 ]; then BRANCH_HYGIENE_OUT=\"$out\" \"$PY\" -c \"import json, os; ctx='=== BRANCH HYGIENE ALERT ===\\n' + os.environ['BRANCH_HYGIENE_OUT'] + '\\n\\nResolve stale branches BEFORE starting new work. See CLAUDE.md > Gitflow > Branch hygiene.'; print(json.dumps({'hookSpecificOutput':{'hookEventName':'SessionStart','additionalContext':ctx}}))\"; elif echo \"$out\" | grep -q 'OLD FORK POINT'; then BRANCH_HYGIENE_OUT=\"$out\" \"$PY\" -c \"import json, os; ctx='=== BRANCHES WITH OLD FORK POINT ===\\n' + os.environ['BRANCH_HYGIENE_OUT'] + '\\n\\nRebase onto latest main before pushing. This is a warning, not a blocker.'; print(json.dumps({'hookSpecificOutput':{'hookEventName':'SessionStart','additionalContext':ctx}}))\"; fi",
            "timeout": 20,
            "statusMessage": "Checking branch hygiene..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "branch=$(git -C __PROJECT_ROOT__ rev-parse --abbrev-ref HEAD); case \"$branch\" in main|master|homolog|staging|develop) echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Cannot push directly to '\"$branch\"'. Protected branch — use a PR or pipeline.\"}}'; exit 0 ;; esac; bash __PROJECT_ROOT__/scripts/check-secrets.sh || echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Secrets detected. Review scripts/check-secrets.sh output.\"}}'",
            "if": "Bash(git push:*)",
            "timeout": 15,
            "statusMessage": "Validating push..."
          }
        ]
      }
    ]
  }
}
