{
  "_comment": "Generated by init-claude-project. __PROJECT_ROOT__ is substituted at install time with the absolute path of this project. Re-run the installer if the project is moved.",
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash __PROJECT_ROOT__/scripts/hook-sessionstart.sh",
            "timeout": 20,
            "statusMessage": "Checking branch hygiene..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash __PROJECT_ROOT__/scripts/hook-prepush-validate.sh",
            "if": "Bash(git push:*)",
            "timeout": 15,
            "statusMessage": "Validating push..."
          }
        ]
      }
    ]
  }
}
