#!/usr/bin/env bash
# Frontend pre-commit.

# 1. TODO budget — flag un-IDed TODO/FIXME in staged changes.
if [ -f scripts/check-todo-budget.sh ]; then
  bash scripts/check-todo-budget.sh || exit 1
fi

# 2. lint-staged (prettier + eslint on staged files, if configured).
if [ -f package.json ] && grep -q '"lint-staged"' package.json; then
  npx --no-install lint-staged
else
  echo "pre-commit: no lint-staged config — skipping."
fi
