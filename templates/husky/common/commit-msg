#!/usr/bin/env bash
commit_msg=$(cat "$1" | tr -d '\r')

# Allow merge commits.
if echo "$commit_msg" | grep -qE "^Merge "; then
  exit 0
fi

# Load project-specific naming convention (optional).
COMMIT_MSG_REGEX=""
COMMIT_MSG_FORMAT=""
COMMIT_MSG_EXAMPLE=""
repo_root=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
if [ -f "$repo_root/.husky/naming.conf" ]; then
  # shellcheck disable=SC1091
  . "$repo_root/.husky/naming.conf"
fi

# Empty regex = check disabled.
[ -z "$COMMIT_MSG_REGEX" ] && exit 0

if ! echo "$commit_msg" | head -1 | grep -qE "$COMMIT_MSG_REGEX"; then
  echo ""
  echo "ERROR: Commit message doesn't match this project's convention."
  echo ""
  [ -n "$COMMIT_MSG_FORMAT" ]  && echo "  Format:  $COMMIT_MSG_FORMAT"
  [ -n "$COMMIT_MSG_EXAMPLE" ] && echo "  Example: $COMMIT_MSG_EXAMPLE"
  echo "  Regex:   $COMMIT_MSG_REGEX"
  echo ""
  echo "  Your message: $commit_msg"
  echo ""
  echo "  Edit .husky/naming.conf to adjust or disable the rule."
  echo ""
  exit 1
fi
