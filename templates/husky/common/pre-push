#!/usr/bin/env bash
branch=$(git rev-parse --abbrev-ref HEAD)

# Protected branches (always enforced — independent of naming.conf).
# Standard convention + user-chosen main/staging (substituted at install time).
# Empty placeholders are safely skipped by the word-split loop.
PROTECTED='main master homolog staging develop {{MAIN_BRANCH}} {{STAGING_BRANCH}}'

for p in $PROTECTED; do
  [ -z "$p" ] && continue
  if [ "$branch" = "$p" ]; then
    echo ""
    echo "ERROR: Cannot push directly to '$branch'."
    echo "Protected branches are updated via PR or pipeline — never by direct push."
    echo ""
    exit 1
  fi
done

# Load project-specific naming convention (optional).
BRANCH_NAME_REGEX=""
BRANCH_NAME_FORMAT=""
BRANCH_NAME_EXAMPLE=""
repo_root=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
if [ -f "$repo_root/.husky/naming.conf" ]; then
  # shellcheck disable=SC1091
  . "$repo_root/.husky/naming.conf"
fi

if [ -n "$BRANCH_NAME_REGEX" ] && ! echo "$branch" | grep -qE "$BRANCH_NAME_REGEX"; then
  echo ""
  echo "ERROR: Branch name '$branch' doesn't match this project's convention."
  echo ""
  [ -n "$BRANCH_NAME_FORMAT" ]  && echo "  Format:  $BRANCH_NAME_FORMAT"
  [ -n "$BRANCH_NAME_EXAMPLE" ] && echo "  Example: $BRANCH_NAME_EXAMPLE"
  echo "  Regex:   $BRANCH_NAME_REGEX"
  echo ""
  echo "  Fix: rename via 'git branch -m $branch <new-name>' before pushing."
  echo "  Edit .husky/naming.conf to adjust or disable the rule."
  echo ""
  exit 1
fi

# Secret scan.
if [ -f scripts/check-secrets.sh ]; then
  bash scripts/check-secrets.sh || exit 1
fi
